# Se combina con .env, conservando las credenciales del PostgreSQL compartido.
# Usar una clave distinta de desarrollo: openssl rand -hex 32
SECRET_KEY=cambiar_esta_clave_exclusiva_para_e2e

# Credenciales exclusivas de pruebas. Generar la contraseña con openssl rand -hex 24.
# El correo sirve como base para generar un administrador temporal por prueba.
E2E_ADMIN_EMAIL=admin-e2e@example.com
E2E_ADMIN_PASSWORD=
